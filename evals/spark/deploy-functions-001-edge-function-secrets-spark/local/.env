# Mock local secrets for the weather widget — committed on purpose as eval
# fixture data (force-added past the repo's .env gitignore). The value is a
# fake placeholder, not a real credential. This file is gitignored *inside the
# agent's workspace*, so the agent must push it to the project as a Function
# secret (e.g. `supabase secrets set --env-file ./.env`) rather than commit it.
WEATHER_API_KEY=mock_wapi_key_eval_do_not_use
