{
  "name": "@supabase-evals/sandbox",
  "private": true,
  "version": "0.0.1",
  "description": "Docker sandbox that exposes the real Supabase CLI as an agent tool surface",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "test:docker": "SANDBOX_DOCKER_TESTS=1 vitest run test/docker.test.ts"
  },
  "dependencies": {
    "@supabase-evals/core": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "ai": "catalog:",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
