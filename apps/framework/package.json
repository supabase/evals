{
  "name": "@supabase-evals/framework",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test:framework",
    "eval": "node --env-file=../../.env --import tsx/esm harness/run-eval.ts",
    "eval:dry": "node --env-file=../../.env --import tsx/esm harness/run-eval.ts --dry",
    "eval:smoke": "node --env-file=../../.env --import tsx/esm harness/run-eval.ts --smoke",
    "eval:force": "node --env-file=../../.env --import tsx/esm harness/run-eval.ts --force",
    "typecheck": "tsc --noEmit",
    "test:framework": "node --import tsx/esm scripts/smoke-framework.ts",
    "export-results": "node --import tsx/esm scripts/export-results.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@electric-sql/pglite": "^0.4.1",
    "@supabase-evals/eval-types": "*",
    "@supabase/supabase-js": "^2.105.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^6.0.168",
    "happy-dom": "^20.9.0",
    "lite-supa": "^0.3.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
