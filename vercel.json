{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @supabase-evals/web exec vite build --base=/",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
