{
  "name": "supabase-evals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check -w @supabase-evals/framework",
    "eval": "npm run eval -w @supabase-evals/framework",
    "eval:dry": "npm run eval:dry -w @supabase-evals/framework",
    "eval:smoke": "npm run eval:smoke -w @supabase-evals/framework",
    "eval:force": "npm run eval:force -w @supabase-evals/framework",
    "test:framework": "npm run test:framework -w @supabase-evals/framework",
    "export-results": "npm run export-results -w @supabase-evals/framework",
    "typecheck": "npm run typecheck -w @supabase-evals/framework && npm run typecheck -w @supabase-evals/web",
    "web": "npm run dev -w @supabase-evals/web",
    "web:build": "npm run build -w @supabase-evals/web",
    "demo:mcp": "npm run -w @supabase-evals/framework demo:mcp"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.8.2"
}
