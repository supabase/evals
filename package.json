{
  "name": "supabase-evals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "pnpm --filter @supabase-evals/framework check",
    "eval": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts",
    "eval:dry": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --dry",
    "eval:smoke": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --smoke",
    "eval:force": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --force",
    "test:framework": "pnpm --filter @supabase-evals/framework test:framework",
    "export-results": "node --import tsx/esm apps/framework/scripts/export-results.ts",
    "typecheck": "pnpm --filter @supabase-evals/framework typecheck && pnpm --filter @supabase-evals/web typecheck",
    "web": "pnpm --filter @supabase-evals/web dev",
    "web:build": "pnpm --filter @supabase-evals/web build",
    "demo:mcp": "pnpm --filter @supabase-evals/framework demo:mcp",
    "demo:executor": "pnpm --filter @supabase-evals/framework demo:executor"
  },
  "dependencies": {
    "common-tags": "^1.8.2"
  },
  "devDependencies": {
    "@supabase-evals/core": "workspace:*",
    "@types/common-tags": "^1.8.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "10.24"
  },
  "packageManager": "pnpm@10.24.0"
}
