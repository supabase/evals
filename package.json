{
  "name": "supabase-evals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check -w @supabase-evals/framework",
    "eval": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts",
    "eval:dry": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --dry",
    "eval:smoke": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --smoke",
    "eval:force": "node --env-file=.env --import tsx/esm apps/framework/harness/run-eval.ts --force",
    "test:framework": "npm run test:framework -w @supabase-evals/framework",
    "export-results": "node --import tsx/esm apps/framework/scripts/export-results.ts",
    "typecheck": "npm run typecheck -w @supabase-evals/framework && npm run typecheck -w @supabase-evals/web",
    "web": "npm run dev -w @supabase-evals/web",
    "web:build": "npm run build -w @supabase-evals/web",
    "demo:mcp": "npm run -w @supabase-evals/framework demo:mcp",
    "demo:executor": "npm run -w @supabase-evals/framework demo:executor"
  },
  "dependencies": {
    "common-tags": "^1.8.2"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.8.2"
}
