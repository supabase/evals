{
  "name": "supabase-evals",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test:framework",
    "eval": "node --import tsx/esm harness/run-eval.ts",
    "eval:dry": "node --import tsx/esm harness/run-eval.ts --dry",
    "eval:smoke": "node --import tsx/esm harness/run-eval.ts --smoke",
    "eval:force": "node --import tsx/esm harness/run-eval.ts --force",
    "typecheck": "tsc --noEmit",
    "test:framework": "node --import tsx/esm scripts/smoke-framework.ts",
    "export-results": "node --import tsx/esm scripts/export-results.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@electric-sql/pglite": "^0.4.1",
    "@supabase/supabase-js": "^2.105.1",
    "ai": "^6.0.168",
    "lite-supa": "^0.3.3"
  },
  "packageManager": "npm@10.8.2"
}
