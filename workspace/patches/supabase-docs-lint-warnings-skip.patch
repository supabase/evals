@@ -591,13 +592,22 @@ function logFailedPages(pageInfoMap: Map<number, PageInfo>, processingResult: Pr
 async function purgeOldPages(
   supabaseClient: SupabaseClient,
   pageTable: string,
-  refreshVersion: string
+  refreshVersion: string,
